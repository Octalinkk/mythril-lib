{
  "expo": {
    "name": "Mythril Library",
    "slug": "mythril-lib",
    "version": "0.1.3",
    "orientation": "portrait",
    "icon": "./src/res/Mithril.png",
    "scheme": "mythrillib",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#7765e0",
        "foregroundImage": "./src/res/Mithril.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./src/res/MithrilSmall.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.solizardstudio.mythrillib"
    },
    "web": {
      "output": "static",
      "favicon": "./src/res/Mithril.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7765e0",
          "android": {
            "image": "./src/res/Mithril.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
